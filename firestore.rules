rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidExpense(data) {
      return data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.amount is number && data.amount >= 0.0 && data.amount <= 10000000.0 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.date is string && data.date.size() == 10 &&
             data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 50 &&
             data.isRecurring is bool &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMonthlyBudget(data) {
      return data.userId == request.auth.uid &&
             data.monthYear is string && data.monthYear.size() == 7 &&
             data.monthlyIncome is number && data.monthlyIncome >= 0.0 && data.monthlyIncome <= 100000000.0 &&
             data.savingsGoal is number && data.savingsGoal >= 0.0 && data.savingsGoal <= 100000000.0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSavingsGoal(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.targetAmount is number && data.targetAmount >= 0.0 && data.targetAmount <= 100000000.0 &&
             data.currentAmount is number && data.currentAmount >= 0.0 && data.currentAmount <= 100000000.0 &&
             data.targetDate is string && data.targetDate.size() == 10 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(expenseId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(expenseId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'title', 'amount', 'category', 'date', 'paymentMethod', 'isRecurring', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'amount', 'category', 'date', 'paymentMethod', 'notes', 'isRecurring', 'createdAt', 'updatedAt']) &&
                       isValidExpense(incoming());
      allow update: if isSignedIn() && isValidId(expenseId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'category', 'date', 'paymentMethod', 'notes', 'isRecurring', 'updatedAt']) &&
                       isValidExpense(incoming());
      allow delete: if isSignedIn() && isValidId(expenseId) && existing().userId == request.auth.uid;
    }

    match /monthly_budgets/{budgetId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(budgetId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(budgetId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'monthYear', 'monthlyIncome', 'savingsGoal', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'monthYear', 'monthlyIncome', 'savingsGoal', 'createdAt', 'updatedAt']) &&
                       isValidMonthlyBudget(incoming());
      allow update: if isSignedIn() && isValidId(budgetId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['monthlyIncome', 'savingsGoal', 'updatedAt']) &&
                       isValidMonthlyBudget(incoming());
      allow delete: if isSignedIn() && isValidId(budgetId) && existing().userId == request.auth.uid;
    }

    match /savings_goals/{goalId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(goalId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(goalId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'name', 'targetAmount', 'currentAmount', 'targetDate', 'category', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'targetAmount', 'currentAmount', 'targetDate', 'category', 'createdAt', 'updatedAt']) &&
                       isValidSavingsGoal(incoming());
      allow update: if isSignedIn() && isValidId(goalId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'targetAmount', 'currentAmount', 'targetDate', 'category', 'updatedAt']) &&
                       isValidSavingsGoal(incoming());
      allow delete: if isSignedIn() && isValidId(goalId) && existing().userId == request.auth.uid;
    }
  }
}
